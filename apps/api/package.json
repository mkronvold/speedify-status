{
  "name": "@speedify-status/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@speedify-status/config": "workspace:*",
    "@speedify-status/contracts": "workspace:*",
    "fastify": "^5.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.32.0",
    "globals": "^17.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.10"
  }
}
