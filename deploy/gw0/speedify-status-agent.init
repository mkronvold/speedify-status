#!/bin/sh /etc/rc.common
# OpenWrt procd init example for speedify-status-agent
# Install:
#   cp speedify-status-agent /usr/bin/speedify-status-agent
#   cp speedify-status-agent.init /etc/init.d/speedify-status-agent
#   cp speedify-status-agent.env.example /etc/speedify-status-agent.env
#   chmod +x /usr/bin/speedify-status-agent /etc/init.d/speedify-status-agent
#   /etc/init.d/speedify-status-agent enable
#   /etc/init.d/speedify-status-agent start

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/speedify-status-agent
ENV_FILE=/etc/speedify-status-agent.env

start_service() {
  procd_open_instance
  procd_set_param command "$PROG"
  if [ -f "$ENV_FILE" ]; then
    procd_set_param env $(grep -v '^#' "$ENV_FILE" | xargs)
  fi
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
