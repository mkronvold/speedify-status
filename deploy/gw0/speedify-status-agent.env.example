# Copy to /etc/speedify-status-agent.env (install.sh does this only if missing).
# Replace the hostname with YOUR reverse-proxy / DNS name for the web front door.
# Example uses speedify.lan — any LAN name is fine (see QUICKSTART.md).
INGEST_URL=http://speedify.lan/api/ingest/sample
# INGEST_TOKEN=   # must match SPEEDIFY_STATUS_INGEST_TOKEN on the API if set
INTERVAL_SEC=1
SPEEDIFY_CLI=/usr/share/speedify/speedify_cli
LATENCY_FALLBACK_HOST=1.1.1.1
