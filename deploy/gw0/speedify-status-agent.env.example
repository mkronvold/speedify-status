# Copy to /etc/speedify-status-agent.env on gw0 (install.sh does this if missing).
# Prefer the NPM front door so the agent uses the same path as browsers.
INGEST_URL=http://speedify.lan/api/ingest/sample
# Fallback if DNS/proxy is down: http://10.0.0.202:4090/api/ingest/sample
# (only if API publishes a host port — default compose does not)
# INGEST_TOKEN=
INTERVAL_SEC=1
SPEEDIFY_CLI=/usr/share/speedify/speedify_cli
LATENCY_FALLBACK_HOST=1.1.1.1
